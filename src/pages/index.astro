<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>我的个人主页</title>
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      @font-face {
        font-family: "MPlus";
        src: url("/public/fonts/mplus_hzk.ttf") format("truetype");
        font-display: swap;
      }

      body {
        font-family: "MPlus", "宋体", monospace;
        background: #008080;
        height: 100vh;
        overflow: hidden;
        font-size: 14px;
        -webkit-font-smoothing: none;
        font-smooth: never;
        image-rendering: pixelated;
        cursor: url("/public/cursors/arrow_m.cur"), auto;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9999;
        background: repeating-linear-gradient(
          0deg,
          rgba(0, 0, 0, 0.12) 0px,
          rgba(0, 0, 0, 0.12) 1px,
          transparent 1px,
          transparent 3px
        );
      }

      .desktop {
        width: 100%;
        height: calc(100vh - 36px);
        padding: 16px;
        position: relative;
      }

      .icons {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 90px;
      }
      .icon {
        width: 90px;
        height: 90px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 6px;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
        color: #fff;
        text-shadow: 1px 1px 0 #000;
        font-size: 14px;
        text-align: center;
        user-select: none;
      }
      .icon.selected {
        outline: 1px dotted #fff;
        outline-offset: 2px;
      }
      .icon-img {
        width: 32px;
        height: 32px;
        margin-bottom: 6px;
        image-rendering: pixelated;
      }

      .search-box {
        position: absolute;
        top: 16px;
        right: 16px;
        display: flex;
        gap: 4px;
        z-index: 50;
      }
      .search-box input {
        background: #fff;
        border: 2px solid;
        border-color: #808080 #ffffff #ffffff #808080;
        padding: 3px 6px;
        font-family: "MPlus", "宋体", monospace;
        font-size: 13px;
        width: 160px;
        -webkit-font-smoothing: none;
        font-smooth: never;
      }
      .search-box button {
        background: #c0c0c0;
        border: 2px solid;
        border-color: #ffffff #808080 #808080 #ffffff;
        padding: 3px 10px;
        font-family: "MPlus", "宋体", monospace;
        font-size: 13px;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
      }
      .search-box button:active {
        border-color: #808080 #ffffff #ffffff #808080;
      }

      /* ===== 底部图标栏（CD + 记事本） ===== */
      .bottom-icons {
        position: absolute;
        bottom: 16px;
        left: 16px;
        display: flex;
        gap: 12px;
      }
      .desktop-icon {
        width: 90px;
        height: 90px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 6px;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
        color: #fff;
        text-shadow: 1px 1px 0 #000;
        font-size: 14px;
        text-align: center;
        user-select: none;
      }
      .desktop-icon.selected {
        outline: 1px dotted #fff;
        outline-offset: 2px;
      }
      .desktop-icon .icon-img {
        width: 40px;
        height: 40px;
        margin-bottom: 6px;
        image-rendering: pixelated;
      }

      .window {
        display: none;
        position: absolute;
        top: 120px;
        left: 200px;
        width: 460px;
        min-width: 240px;
        min-height: 120px;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #ffffff #808080 #808080 #ffffff;
        box-shadow: 3px 3px 0 #000;
        z-index: 10;
        overflow: hidden;
      }
      .window.active {
        display: block;
      }

      .title-bar {
        background: #000080;
        color: #fff;
        padding: 4px 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        font-weight: bold;
        letter-spacing: 1px;
        cursor: url("/public/cursors/move_m.cur"), move;
        user-select: none;
      }
      .title-bar .title-buttons {
        display: flex;
        gap: 2px;
      }
      .title-bar button {
        width: 20px;
        height: 18px;
        font-size: 11px;
        background: #c0c0c0;
        border: 2px solid;
        border-color: #ffffff #808080 #808080 #ffffff;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
        line-height: 1;
        padding: 0;
        color: #000;
      }
      .title-bar button:active {
        border-color: #808080 #ffffff #ffffff #808080;
      }

      .window-body {
        padding: 14px;
        font-size: 14px;
        line-height: 1.8;
        color: #000;
        overflow: auto;
        height: calc(100% - 28px);
      }
      .window-body h2 {
        font-size: 15px;
        margin-bottom: 8px;
      }
      .window-body a {
        color: #000080;
        text-decoration: underline;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
      }

      /* ===== 八向调整大小手柄 ===== */
      .resize-handle {
        position: absolute;
        z-index: 5;
      }
      .resize-handle.n {
        top: -4px;
        left: 8px;
        right: 8px;
        height: 8px;
        cursor: url("/public/cursors/size4_im.cur"), ns-resize;
      }
      .resize-handle.s {
        bottom: -4px;
        left: 8px;
        right: 8px;
        height: 8px;
        cursor: url("/public/cursors/size4_im.cur"), ns-resize;
      }
      .resize-handle.e {
        right: -4px;
        top: 8px;
        bottom: 8px;
        width: 8px;
        cursor: url("/public/cursors/size3_im.cur"), ew-resize;
      }
      .resize-handle.w {
        left: -4px;
        top: 8px;
        bottom: 8px;
        width: 8px;
        cursor: url("/public/cursors/size3_im.cur"), ew-resize;
      }
      .resize-handle.ne {
        top: -4px;
        right: -4px;
        width: 12px;
        height: 12px;
        cursor: url("/public/cursors/size1_im.cur"), nesw-resize;
      }
      .resize-handle.sw {
        bottom: -4px;
        left: -4px;
        width: 12px;
        height: 12px;
        cursor: url("/public/cursors/size1_im.cur"), nesw-resize;
      }
      .resize-handle.nw {
        top: -4px;
        left: -4px;
        width: 12px;
        height: 12px;
        cursor: url("/public/cursors/size2_im.cur"), nwse-resize;
      }
      .resize-handle.se {
        bottom: -4px;
        right: -4px;
        width: 12px;
        height: 12px;
        cursor: url("/public/cursors/size2_im.cur"), nwse-resize;
      }

      .taskbar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 36px;
        background: #c0c0c0;
        border-top: 2px solid #ffffff;
        display: flex;
        align-items: center;
        padding: 0 6px;
        gap: 8px;
        z-index: 1000;
      }
      .start-btn {
        background: #c0c0c0;
        border: 2px solid;
        border-color: #ffffff #808080 #808080 #ffffff;
        padding: 3px 12px;
        font-family: "MPlus", "宋体", monospace !important;
        font-size: 12px;
        font-weight: bold;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        -webkit-font-smoothing: none;
        font-smooth: never;
        letter-spacing: 0;
      }
      .start-btn:active {
        border-color: #808080 #ffffff #ffffff #808080;
      }
      .start-icon {
        width: 16px;
        height: 16px;
        image-rendering: pixelated;
      }
      .taskbar-items {
        display: flex;
        gap: 4px;
        flex: 1;
      }
      button.taskbar-item,
      button.start-btn,
      .taskbar-item {
        font-family: "MPlus", "宋体", monospace !important;
        -webkit-font-smoothing: none !important;
        font-smooth: never !important;
        font-size: 12px !important;
        letter-spacing: 0 !important;
      }
      .taskbar-item {
        background: #c0c0c0;
        border: 2px solid;
        border-color: #ffffff #808080 #808080 #ffffff;
        border-left: 1px solid #dfdfdf;
        border-right: 1px solid #808080;
        padding: 3px 12px;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
        max-width: 160px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        color: #000;
      }
      .taskbar-item:active,
      .taskbar-item.active {
        border-color: #808080 #ffffff #ffffff #808080;
        font-weight: bold;
        background: #dfdfdf;
      }
      .tray {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 8px;
        border-left: 1px solid #808080;
        border-right: 1px solid #ffffff;
        height: 28px;
      }
      .tray-icon {
        font-size: 14px;
      }
      .clock {
        background: #c0c0c0;
        padding: 3px 10px;
        font-size: 12px;
        font-family: "MPlus", "宋体", monospace;
        -webkit-font-smoothing: none;
        font-smooth: never;
        border-left: 1px solid #808080;
        border-right: 1px solid #ffffff;
      }

      .cd-track {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4px 6px;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
        font-size: 13px;
      }
      .cd-track:hover {
        background: #000080;
        color: #fff;
      }
      .cd-track.active {
        background: #000080;
        color: #fff;
      }
      .cd-controls {
        display: flex;
        gap: 6px;
        margin-top: 10px;
      }
      .cd-controls button {
        background: #c0c0c0;
        border: 2px solid;
        border-color: #ffffff #808080 #808080 #ffffff;
        padding: 3px 10px;
        font-family: "MPlus", "宋体", monospace;
        font-size: 12px;
        cursor: url("/public/cursors/hand-m.cur"), pointer;
      }
      .cd-controls button:active {
        border-color: #808080 #ffffff #ffffff #808080;
      }

      input,
      textarea,
      [contenteditable] {
        cursor: url("/public/cursors/beam_1.cur"), text;
      }
      .loading,
      .busy {
        cursor: url("/public/cursors/busy_m.cur"), wait;
      }
      .disabled {
        cursor: url("/public/cursors/no_m.cur"), not-allowed;
      }
      .help {
        cursor: url("/public/cursors/help_m.cur"), help;
      }
    </style>
  </head>
  <body>
    <div class="desktop">
      <div class="search-box">
        <input type="text" id="search-input" placeholder="搜索..." />
        <button id="search-btn">搜索</button>
      </div>

      <!-- 左侧图标栏 -->
      <div class="icons">
        <div class="icon" data-window="computer">
          <img
            class="icon-img"
            src="/public/icons/computer-4.png"
            alt="此电脑"
          />
          <span>此电脑</span>
        </div>
        <div class="icon" data-window="files">
          <img
            class="icon-img"
            src="/public/icons/directory_closed-4.png"
            alt="资料"
          />
          <span>资料</span>
        </div>
        <div class="icon" data-window="browser">
          <img
            class="icon-img"
            src="/public/icons/msie1-2.png"
            alt="其他网站"
          />
          <span>其他网站</span>
        </div>
      </div>

      <!-- 底部图标栏：CD + 记事本 -->
      <div class="bottom-icons">
        <div class="desktop-icon" data-window="cd">
          <img
            class="icon-img"
            src="/public/icons/cd_audio_cd_a-4.png"
            alt="CD"
          />
          <span>CD</span>
        </div>
        <div class="desktop-icon">
          <img
            class="icon-img"
            src="/public/icons/notepad-2.png"
            alt="记事本"
          />
          <span>记事本</span>
        </div>
      </div>

      <!-- 窗口 -->
      <div class="window" id="window-computer" style="top: 100px; left: 180px;">
        <div class="title-bar">
          <span>💻 此电脑</span>
          <div class="title-buttons">
            <button data-action="minimize">_</button>
            <button data-action="maximize">□</button>
            <button data-action="close">×</button>
          </div>
        </div>
        <div class="window-body">
          <h2>关于我</h2>
          <p>你好，我是【你的名字】。</p>
          <p>这里写一句话介绍你自己。</p>
        </div>
        <div class="resize-handle n"></div>
        <div class="resize-handle s"></div>
        <div class="resize-handle e"></div>
        <div class="resize-handle w"></div>
        <div class="resize-handle ne"></div>
        <div class="resize-handle nw"></div>
        <div class="resize-handle se"></div>
        <div class="resize-handle sw"></div>
      </div>

      <div class="window" id="window-files" style="top: 140px; left: 240px;">
        <div class="title-bar">
          <span>📁 资料</span>
          <div class="title-buttons">
            <button data-action="minimize">_</button>
            <button data-action="maximize">□</button>
            <button data-action="close">×</button>
          </div>
        </div>
        <div class="window-body">
          <h2>我的作品</h2>
          <p><a href="#">作品一</a></p>
          <p><a href="#">作品二</a></p>
          <p><a href="#">作品三</a></p>
        </div>
        <div class="resize-handle n"></div>
        <div class="resize-handle s"></div>
        <div class="resize-handle e"></div>
        <div class="resize-handle w"></div>
        <div class="resize-handle ne"></div>
        <div class="resize-handle nw"></div>
        <div class="resize-handle se"></div>
        <div class="resize-handle sw"></div>
      </div>

      <div class="window" id="window-browser" style="top: 180px; left: 300px;">
        <div class="title-bar">
          <span>🌐 其他网站</span>
          <div class="title-buttons">
            <button data-action="minimize">_</button>
            <button data-action="maximize">□</button>
            <button data-action="close">×</button>
          </div>
        </div>
        <div class="window-body">
          <h2>友情链接</h2>
          <p><a href="#">微博</a></p>
          <p><a href="#">B站</a></p>
          <p><a href="#">邮箱</a></p>
        </div>
        <div class="resize-handle n"></div>
        <div class="resize-handle s"></div>
        <div class="resize-handle e"></div>
        <div class="resize-handle w"></div>
        <div class="resize-handle ne"></div>
        <div class="resize-handle nw"></div>
        <div class="resize-handle se"></div>
        <div class="resize-handle sw"></div>
      </div>

      <div
        class="window"
        id="window-cd"
        style="top: 200px; left: 360px; width: 360px;"
      >
        <div class="title-bar">
          <span>💿 CD 播放器</span>
          <div class="title-buttons">
            <button data-action="minimize">_</button>
            <button data-action="maximize">□</button>
            <button data-action="close">×</button>
          </div>
        </div>
        <div class="window-body">
          <h2>曲目列表</h2>
          <div id="cd-tracks">
            <div class="cd-track" data-src="/public/music/track1.mp3">
              01. 曲目一
            </div>
            <div class="cd-track" data-src="/public/music/track2.mp3">
              02. 曲目二
            </div>
            <div class="cd-track" data-src="/public/music/track3.mp3">
              03. 曲目三
            </div>
          </div>
          <div class="cd-controls">
            <button id="cd-play">▶ 播放</button>
            <button id="cd-pause">⏸ 暂停</button>
            <button id="cd-stop">⏹ 停止</button>
          </div>
          <audio id="cd-audio"></audio>
        </div>
        <div class="resize-handle n"></div>
        <div class="resize-handle s"></div>
        <div class="resize-handle e"></div>
        <div class="resize-handle w"></div>
        <div class="resize-handle ne"></div>
        <div class="resize-handle nw"></div>
