        <div class="resize-handle sw"></div>
      </div>
    </div>

    <div class="taskbar">
      <button class="start-btn">
        <img src="/public/icons/windows-0.png" class="start-icon" alt="开始" />
        开始
      </button>
      <div class="taskbar-items" id="taskbar-items"></div>
      <div class="tray">
        <span class="tray-icon">🔊</span>
      </div>
      <div class="clock" id="clock">--:--</div>
    </div>

    <script is:inline>
      var taskbarItems = document.getElementById("taskbar-items");
      var openWindows = {};

      document
        .querySelectorAll(".icon, .desktop-icon")
        .forEach(function (icon) {
          icon.addEventListener("dblclick", function () {
            var id = icon.dataset.window;
            if (!id) return;
            var win = document.getElementById("window-" + id);
            if (!win) return;
            if (!openWindows[win.id]) {
              addTaskbarItem(win);
            }
            activateWindow(win);
          });
          icon.addEventListener("click", function () {
            document
              .querySelectorAll(".icon, .desktop-icon")
              .forEach(function (i) {
                i.classList.remove("selected");
              });
            icon.classList.add("selected");
          });
        });

      document
        .querySelector(".desktop")
        .addEventListener("click", function (e) {
          if (e.target.classList.contains("desktop")) {
            document
              .querySelectorAll(".icon, .desktop-icon")
              .forEach(function (i) {
                i.classList.remove("selected");
              });
          }
        });

      function activateWindow(win) {
        document.querySelectorAll(".window").forEach(function (w) {
          w.style.zIndex = 10;
        });
        win.classList.add("active");
        win.style.zIndex = 100;
        document.querySelectorAll(".taskbar-item").forEach(function (item) {
          item.classList.remove("active");
        });
        if (openWindows[win.id]) {
          openWindows[win.id].classList.add("active");
        }
      }

      function addTaskbarItem(win) {
        var btn = document.createElement("button");
        btn.className = "taskbar-item active";
        btn.textContent = win.querySelector(".title-bar span").textContent;
        btn.addEventListener("click", function () {
          activateWindow(win);
        });
        taskbarItems.appendChild(btn);
        openWindows[win.id] = btn;
      }

      function removeTaskbarItem(win) {
        if (openWindows[win.id]) {
          openWindows[win.id].remove();
          delete openWindows[win.id];
        }
      }

      document.querySelectorAll(".title-bar button").forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          var win = e.target.closest(".window");
          var action = btn.dataset.action;

          if (action === "close") {
            win.classList.remove("active");
            removeTaskbarItem(win);
          } else if (action === "minimize") {
            win.classList.remove("active");
            if (openWindows[win.id]) {
              openWindows[win.id].classList.remove("active");
            }
          } else if (action === "maximize") {
            if (win.dataset.maximized === "true") {
              win.style.width = win.dataset.oldWidth;
              win.style.height = win.dataset.oldHeight;
              win.style.left = win.dataset.oldLeft;
              win.style.top = win.dataset.oldTop;
              win.dataset.maximized = "false";
            } else {
              win.dataset.oldWidth = win.style.width;
              win.dataset.oldHeight = win.style.height;
              win.dataset.oldLeft = win.style.left;
              win.dataset.oldTop = win.style.top;
              win.style.width = "100%";
              win.style.height = "calc(100vh - 36px)";
              win.style.left = "0";
              win.style.top = "0";
              win.dataset.maximized = "true";
            }
          }
        });
      });

      function updateClock() {
        var now = new Date();
        var h = String(now.getHours()).padStart(2, "0");
        var m = String(now.getMinutes()).padStart(2, "0");
        var clock = document.getElementById("clock");
        if (clock)
          clock.textContent =
            h + ":" + m + " " + (now.getMonth() + 1) + "/" + now.getDate();
      }
      updateClock();
      setInterval(updateClock, 1000);

      document.querySelectorAll(".window").forEach(function (win) {
        var titleBar = win.querySelector(".title-bar");
        var isDragging = false;
        var offsetX = 0,
          offsetY = 0;

        titleBar.addEventListener("mousedown", function (e) {
          if (win.dataset.maximized === "true") return;
          e.preventDefault();
          isDragging = true;
          offsetX = e.clientX - win.offsetLeft;
          offsetY = e.clientY - win.offsetTop;
          activateWindow(win);
        });

        document.addEventListener("mousemove", function (e) {
          if (!isDragging) return;
          win.style.left = e.clientX - offsetX + "px";
          win.style.top = e.clientY - offsetY + "px";
        });

        document.addEventListener("mouseup", function () {
          isDragging = false;
        });
      });

      document.querySelectorAll(".resize-handle").forEach(function (handle) {
        var win = handle.closest(".window");
        var dir = handle.classList[1];
        var isResizing = false;
        var startX = 0,
          startY = 0;
        var startW = 0,
          startH = 0,
          startL = 0,
          startT = 0;

        handle.addEventListener("mousedown", function (e) {
          e.stopPropagation();
          e.preventDefault();
          isResizing = true;
          startX = e.clientX;
          startY = e.clientY;
          startW = win.offsetWidth;
          startH = win.offsetHeight;
          startL = win.offsetLeft;
          startT = win.offsetTop;
          activateWindow(win);
        });

        document.addEventListener("mousemove", function (e) {
          if (!isResizing) return;
          var dx = e.clientX - startX;
          var dy = e.clientY - startY;

          if (dir.indexOf("e") !== -1) win.style.width = startW + dx + "px";
          if (dir.indexOf("s") !== -1) win.style.height = startH + dy + "px";
          if (dir.indexOf("w") !== -1) {
            win.style.width = startW - dx + "px";
            win.style.left = startL + dx + "px";
          }
          if (dir.indexOf("n") !== -1) {
            win.style.height = startH - dy + "px";
            win.style.top = startT + dy + "px";
          }
        });

        document.addEventListener("mouseup", function () {
          isResizing = false;
        });
      });

      var cdAudio = document.getElementById("cd-audio");
      document.querySelectorAll(".cd-track").forEach(function (track) {
        track.addEventListener("dblclick", function () {
          document.querySelectorAll(".cd-track").forEach(function (t) {
            t.classList.remove("active");
          });
          track.classList.add("active");
          cdAudio.src = track.dataset.src;
          cdAudio.play();
        });
      });
      document.getElementById("cd-play").addEventListener("click", function () {
        if (cdAudio.src) cdAudio.play();
      });
      document
        .getElementById("cd-pause")
        .addEventListener("click", function () {
          cdAudio.pause();
        });
      document.getElementById("cd-stop").addEventListener("click", function () {
        cdAudio.pause();
        cdAudio.currentTime = 0;
      });

      document
        .getElementById("search-btn")
        .addEventListener("click", function () {
          var keyword = document.getElementById("search-input").value.trim();
          if (!keyword) return;
          document.querySelectorAll("mark.search-hit").forEach(function (m) {
            m.outerHTML = m.innerHTML;
          });
          document.querySelectorAll(".window-body").forEach(function (body) {
            if (body.innerHTML.indexOf(keyword) !== -1) {
              body.innerHTML = body.innerHTML.replace(
                new RegExp(keyword, "g"),
                '<mark class="search-hit" style="background:#ff0;color:#000;">' +
                  keyword +
                  "</mark>",
              );
            }
          });
        });
    </script>
  </body>
</html>
